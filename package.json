{
  "name": "tab-session-manager",
  "version": "0.0.0",
  "engines": {
    "node": "24.13.0",
    "npm": "11.7.0"
  },
  "dependencies": {
    "browser-image-compression": "^1.0.14",
    "browser-info": "^1.2.0",
    "clone": "^2.1.2",
    "lodash": "^4.17.21",
    "loglevel": "^1.6.7",
    "moment": "^2.29.4",
    "mozlz4a": "^1.1.0",
    "prop-types": "^15.7.2",
    "query-string": "^6.11.1",
    "react": "^16.13.1",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^16.13.1",
    "react-highlight-words": "^0.16.0",
    "react-router": "^5.1.2",
    "react-router-dom": "^5.1.2",
    "react-transition-group": "^4.3.0",
    "url": "^0.11.0",
    "uuid": "^11.1.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.9.0",
    "@babel/plugin-proposal-optional-chaining": "^7.10.3",
    "@babel/plugin-syntax-jsx": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "@playwright/test": "^1.61.0",
    "@svgr/webpack": "^8.1.0",
    "babel-loader": "^8.1.0",
    "babel-plugin-istanbul": "^8.0.0",
    "buffer": "^6.0.3",
    "clean-webpack-plugin": "^0.1.19",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^1.6.0",
    "nyc": "^18.0.0",
    "playwright-webextext": "^0.0.5",
    "prettier": "^3.0.0",
    "sass": "^1.86.0",
    "sass-loader": "^14.2.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^4.8.0",
    "zip-webpack-plugin": "^4.0.1"
  },
  "scripts": {
    "watch-dev": "webpack --config webpack.config.dev.js --watch",
    "build-dev": "webpack --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.dist.js",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:chrome": "playwright test --config e2e/playwright.config.js --project=chrome-mv3",
    "e2e:firefox": "E2E_RUN_FF=1 playwright test --config e2e/playwright.config.js --project=firefox-mv3",
    "e2e:all": "E2E_RUN_FF=1 playwright test --config e2e/playwright.config.js",
    "coverage:clean": "rm -rf .nyc_output coverage",
    "coverage:collect": "COVERAGE=1 playwright test --config e2e/playwright.config.js --project=chrome-mv3",
    "coverage:report": "nyc report",
    "coverage": "npm run coverage:clean && npm run coverage:collect && npm run coverage:report",
    "format": "prettier --write \"src/**/*.{js,jsx,json,scss,html,md}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,scss,html,md}\" \"*.{js,json,md}\"",
    "e2e:patch-juggler": "bash e2e/juggler-patch/apply.sh",
    "postinstall": "bash e2e/juggler-patch/apply.sh || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sienori/Tab-Session-Manager.git"
  },
  "author": "Sienori",
  "license": "MPL-2.0",
  "description": "WebExtensions for saving and restoring sessions.",
  "bugs": {
    "url": "https://github.com/sienori/Tab-Session-Manager/issues"
  },
  "homepage": "https://github.com/sienori/Tab-Session-Manager#readme",
  "main": ".src/manifest.json",
  "keywords": [
    "webextensions",
    "firefox",
    "chrome"
  ]
}
